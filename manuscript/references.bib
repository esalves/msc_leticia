@article{silvaInicioOportunoPrenatal2025,
  title = {Início Oportuno Do Pré-Natal Em Adolescentes Vítimas de Violência Sexual: Implicações Para o Aborto Legal No Brasil},
  shorttitle = {Início Oportuno Do Pré-Natal Em Adolescentes Vítimas de Violência Sexual},
  author = {family=Silva, given=Luiza Eunice Sá, prefix=da, useprefix=false and Costa, Janaína Calu and Blumenberg, Cauane and Lima, Natália Peixoto and Ruas, Luis Paulo Vidaletti and Costa, Francine dos Santos and family=Barros, given=Aluísio Jardim Dornellas, prefix=de, useprefix=false and Wehrmeister, Fernando César and Victora, César Gomes},
  date = {2025},
  journaltitle = {Ciência \& Saúde Coletiva},
  shortjournal = {Ciênc. Saúde Coletiva},
  volume = {30},
  pages = {e18682024},
  publisher = {ABRASCO - Associação Brasileira de Saúde Coletiva},
  issn = {1413-8123, 1678-4561},
  doi = {10.1590/1413-81232025301.18682024},
  url = {https://www.scielo.br/j/csc/a/6n8r3HxCGFBFZZWLPzY9Qqc/abstract/?lang=pt},
  urldate = {2026-05-18},
  abstract = {Resumo Investigamos o início do pré-natal em adolescentes brasileiras para subsidiar a discussão nacional sobre o limite de idade gestacional para o aborto legal. Com dados do Sistema de Informação sobre Nascidos Vivos (SINASC) 2020-2022 correlacionamos o início oportuno do pré-natal (primeiro trimestre da gestação) com a idade da adolescente, região, raça/cor e escolaridade; 11.607 partos anuais resultam de estupro de vulnerável. O início oportuno foi de 70,2\% para todas as adolescentes ({$<$}20 anos), mas de apenas 55,6\% para aquelas abaixo de 13 anos; 14,1\% das adolescentes iniciaram o pré-natal com 22 semanas ou mais de gestação (28,3\% entre {$<$}13 anos). O início oportuno foi menor na região Norte, entre meninas indígenas e com baixa escolaridade. Demoras no reconhecimento da gestação e na comunicação para a família contribuem para o início tardio do pré-natal e para a decisão de abortar. A proposta de limite do prazo para abortos legais irá atingir principalmente as adolescentes mais vulneráveis em termos socioeconômicos e raciais.},
  langid = {english},
  keywords = {Aborto,Cuidado pré-natal,Estupro,Gravidez na Adolescência,Nascido vivo},
  file = {/Users/eduardosantos/Library/CloudStorage/GoogleDrive-esantos2@ualberta.ca/My Drive/ZotMoov/refsDissertacaoLe/Silva et al. - 2025 - Início oportuno do pré-natal em adolescentes vítimas de violência sexual implicações para o aborto.pdf}
}

